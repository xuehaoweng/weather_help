# Set true to run the app without a QWeather account.
QWEATHER_MOCK=true

# Set QWEATHER_MOCK=false and fill these values when using real QWeather data.
QWEATHER_PROJECT_ID=
QWEATHER_CREDENTIAL_ID=
QWEATHER_API_KEY=
QWEATHER_API_HOST=devapi.qweather.com
QWEATHER_GEO_HOST=geoapi.qweather.com
PORT=8787

# Optional privacy-friendly analytics and administrator dashboard.
# Keep disabled unless you set both secrets below.
ANALYTICS_ENABLED=false
ANALYTICS_HASH_SECRET=
ADMIN_PASSWORD=
